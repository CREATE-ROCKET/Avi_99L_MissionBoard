# Characterizationのepoch/sample clockはGPTimer ISRを使用する。
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y

# ESP-IDF frameworkは公式performance最適化(-O2)を使用する。
# MissionBoard自前componentの-O3はsrc/CMakeLists.txtでcharacterization時だけ追加する。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_LTO_LINKTIME is not set
# CONFIG_COMPILER_LTO_COMPILETIME is not set
